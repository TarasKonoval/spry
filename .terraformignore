# What an HCP Terraform run uploads. Both workspaces take the whole repository:
# successfulsuccess-dev (working directory infra) needs infra/ and
# backend/app/reports/mailer.py; successfulsuccess-gcp-dev (gcp) only gcp/.

# Never upload these: local credentials and settings.
.env
.env.*
!.env.example

# Large, and nothing Terraform reads.
.git/
node_modules/
frontend/
docs/
notes/
backend/.venv/
**/__pycache__/
**/.pytest_cache/
**/.ruff_cache/

# Local Terraform files.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
infra/.build/
